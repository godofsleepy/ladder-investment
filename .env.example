POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ladder:change-me@127.0.0.1:54329/ladder

# Optional. Who may create an account: addresses and @domains, comma-separated. Empty means anyone who can reach the server.
LADDER_ALLOWED_EMAILS=

# Optional. The public address, if a proxy hides it. Set this before turning on email.
LADDER_PUBLIC_URL=

# Optional. Email for password resets and notifications, e.g. smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=
EMAIL_FROM=Ladder <no-reply@example.com>

# Optional. Shows "Continue with Google". The redirect URI is <your address>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Which account a local stdio MCP server acts as. Not needed with a single account.
LADDER_TOKEN=
